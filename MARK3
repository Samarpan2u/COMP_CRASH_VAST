<?xml version="1.0" encoding="UTF-8"?>
<VAST version="3.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="vast.xsd">

    <!-- AD 1 -->
    <Ad id="webhook-crash-ad-1" sequence="1">
        <InLine>

            <AdSystem version="3.0">
                Test Ad Server
            </AdSystem>

            <AdTitle><![CDATA[
                Webhook Crash Reproduction - Audience Codes
            ]]></AdTitle>

            <Impression>
                https://example.com/impression?audience=[webhook.audienceCodes]
            </Impression>

            <Creatives>

                <Creative id="webhook-crash-creative-1">
                    <Linear>

                        <Duration>00:00:30</Duration>

                        <TrackingEvents>

                            <Tracking event="start">
                                https://example.com/start?audience=[webhook.audienceCodes]
                            </Tracking>

                            <Tracking event="firstQuartile">
                                https://example.com/q1?audience=[webhook.audienceCodes]
                            </Tracking>

                            <Tracking event="midpoint">
                                https://example.com/mid?audience=[webhook.audienceCodes]
                            </Tracking>

                            <Tracking event="thirdQuartile">
                                https://example.com/q3?audience=[webhook.audienceCodes]
                            </Tracking>

                            <Tracking event="complete">
                                https://example.com/complete?audience=[webhook.audienceCodes]
                            </Tracking>

                        </TrackingEvents>

                        <VideoClicks>

                            <ClickThrough>
                                https://example.com/click?audience=[webhook.audienceCodes]
                            </ClickThrough>

                            <ClickTracking>
                                https://example.com/clicktrack?audience=[webhook.audienceCodes]
                            </ClickTracking>

                        </VideoClicks>

                        <MediaFiles>

                            <MediaFile
                                delivery="progressive"
                                type="video/mp4"
                                width="1920"
                                height="1080"
                                scalable="true"
                                maintainAspectRatio="true"><![CDATA[
https://s-usweb.dotomi.com/archiver/transcoded-videos/2c4/2c45d3a5398b0e915668e77c60e1f32f57b22eca06c17c00bc046d768bee1b46.mp4
                            ]]></MediaFile>

                        </MediaFiles>

                    </Linear>
                </Creative>

            </Creatives>

        </InLine>
    </Ad>


    <!-- AD 2 -->
    <Ad id="webhook-crash-ad-2" sequence="2">
        <InLine>

            <AdSystem version="3.0">
                Test Ad Server
            </AdSystem>

            <AdTitle><![CDATA[
                Webhook Crash Reproduction - Default
            ]]></AdTitle>

            <Impression>
                https://example.com/impression?audience=[webhook.audienceCodes=player.idxseg]
            </Impression>

            <Creatives>

                <Creative id="webhook-crash-creative-2">
                    <Linear>

                        <Duration>00:00:30</Duration>

                        <TrackingEvents>

                            <Tracking event="start">
                                https://example.com/start?audience=[webhook.audienceCodes=player.idxseg]
                            </Tracking>

                            <Tracking event="complete">
                                https://example.com/complete?audience=[webhook.audienceCodes=player.idxseg]
                            </Tracking>

                        </TrackingEvents>

                        <VideoClicks>

                            <ClickThrough>
                                https://example.com/click?audience=[webhook.audienceCodes=player.idxseg]
                            </ClickThrough>

                        </VideoClicks>

                        <MediaFiles>

                            <MediaFile
                                delivery="progressive"
                                type="video/mp4"
                                width="1920"
                                height="1080"
                                scalable="true"
                                maintainAspectRatio="true"><![CDATA[
https://s-usweb.dotomi.com/archiver/transcoded-videos/2c4/2c45d3a5398b0e915668e77c60e1f32f57b22eca06c17c00bc046d768bee1b46.mp4
                            ]]></MediaFile>

                        </MediaFiles>

                    </Linear>
                </Creative>

            </Creatives>

        </InLine>
    </Ad>


    <!-- AD 3 - Mix webhook + player + user + asset macros -->
    <Ad id="webhook-crash-ad-3" sequence="3">
        <InLine>

            <AdSystem version="3.0">
                Test Ad Server
            </AdSystem>

            <AdTitle><![CDATA[
                Webhook + User + Player + Asset Macro Test
            ]]></AdTitle>

            <Impression>
                https://example.com/impression?audience=[webhook.audienceCodes]&player=[player.idxseg]&user=[user.id]&asset=[asset.id]
            </Impression>

            <Creatives>

                <Creative id="webhook-crash-creative-3">
                    <Linear>

                        <Duration>00:00:30</Duration>

                        <TrackingEvents>

                            <Tracking event="start">
                                https://example.com/start?audience=[webhook.audienceCodes]&player=[player.idxseg]&user=[user.id]&asset=[asset.id]
                            </Tracking>

                            <Tracking event="complete">
                                https://example.com/complete?audience=[webhook.audienceCodes]&player=[player.idxseg]&user=[user.id]&asset=[asset.id]
                            </Tracking>

                        </TrackingEvents>

                        <VideoClicks>

                            <ClickThrough>
                                https://example.com/click?audience=[webhook.audienceCodes]&player=[player.idxseg]&user=[user.id]&asset=[asset.id]
                            </ClickThrough>

                        </VideoClicks>

                        <MediaFiles>

                            <MediaFile
                                delivery="progressive"
                                type="video/mp4"
                                width="1920"
                                height="1080"
                                scalable="true"
                                maintainAspectRatio="true"><![CDATA[
https://s-usweb.dotomi.com/archiver/transcoded-videos/2c4/2c45d3a5398b0e915668e77c60e1f32f57b22eca06c17c00bc046d768bee1b46.mp4
                            ]]></MediaFile>

                        </MediaFiles>

                    </Linear>
                </Creative>

            </Creatives>

        </InLine>
    </Ad>

</VAST>
